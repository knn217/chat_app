# Stage 1: Compute a recipe file for caching dependencies
FROM rust:1.99-slim AS chef
RUN cargo install cargo-chef
WORKDIR /backend_builder

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
COPY --from=planner /backend_builder/recipe.json recipe.json

# Install build essentials, OpenSSL headers, and curl (required for utoipa-swagger-ui build script)
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    build-essential \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN cargo chef cook --profile=release --package=backend --recipe-path=recipe.json

# Build the binary for image
COPY . .
RUN cargo build --profile=release --package=backend

# Create a new stage with a minimal image
FROM debian:bookworm-slim
# Install required runtime libraries (like OpenSSL and SSL certificates)
RUN apt-get update && apt-get install -y \
    libssl3 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app

# Copy the bin from builder into the new minimal image
COPY --from=builder /backend_builder/target/release/backend /app/backend
ENTRYPOINT ["/app/backend"]
EXPOSE 8080