# Copy to .env and fill in. .env is git-ignored.

# CockroachDB image tag. "latest-v26.1" follows patch releases within one major
# version; replace with an exact tag (e.g. v26.1.x) to pin completely.
COCKROACH_VERSION=latest-v26.1

# Host port the SQL interface is published on (bound to 127.0.0.1 only).
DB_PORT=26257

# Application database and the least-privilege role your auth service uses.
APP_DB_NAME=chat
APP_DB_USER=chat_app

# REQUIRED. At least 12 characters, only A-Z a-z 0-9 . _ -
# Generate one with:  openssl rand -hex 24
APP_DB_PASSWORD=

# Enterprise Free license (see README, "License"). Both are optional here, but
# you need them for a long-lived cluster. Leave blank until you have them.
COCKROACH_ORG=
COCKROACH_LICENSE=
